<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        OAuth credentials are encrypted with a device-local Android Keystore key.
        Do not transfer ciphertext or private subscription data to another device.
        Users can migrate settings with the app's explicit export/import feature.
        Device-transfer exclusions are necessary even with allowBackup=false on
        some devices: https://developer.android.com/identity/data/autobackup
    -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
